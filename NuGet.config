<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep the (large) package cache off the system drive. -->
    <add key="globalPackagesFolder" value="../.tools/nuget" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
