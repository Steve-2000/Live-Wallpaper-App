<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20,28,28">
        <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="General Settings" Style="{StaticResource DcPageTitle}" />

            <Border Style="{StaticResource DcCard}" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="StartupToggle" Header="Start the wallpaper engine when I sign in to Windows" Toggled="OnStartupToggled" />
                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Text="Restores your live wallpaper automatically after sign-in. Registered for your user account only; no administrator rights needed." />
                    <InfoBar x:Name="StartupInfo" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="Data" Style="{StaticResource DcSectionTitle}" />
            <Border Style="{StaticResource DcCard}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DataPath" Opacity="0.7" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Open data folder" Click="OnOpenData" />
                        <Button Content="Open logs" Click="OnOpenLogs" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource DcSectionTitle}" />
            <Border Style="{StaticResource DcCard}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="DreamCanvas is free. Every built-in wallpaper is original artwork generated by code - no downloaded images or videos." />
                    <TextBlock Text="Open-source components" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock x:Name="LicensesText" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Roadmap" Style="{StaticResource DcSectionTitle}" />
            <Border Style="{StaticResource DcCard}">
                <TextBlock x:Name="RoadmapText" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
