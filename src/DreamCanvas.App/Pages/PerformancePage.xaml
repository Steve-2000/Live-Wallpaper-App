<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20,28,28">
        <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Performance" Style="{StaticResource DcPageTitle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Live wallpapers are GPU-accelerated. These options trade smoothness for battery life and lower GPU load. Changes apply immediately." />

            <Border Style="{StaticResource DcCard}" Margin="0,12,0,0">
                <StackPanel Spacing="16">
                    <RadioButtons x:Name="FpsChoice" Header="Frame rate limit" MaxColumns="4" SelectionChanged="OnChanged">
                        <x:String>15 FPS</x:String>
                        <x:String>24 FPS</x:String>
                        <x:String>30 FPS</x:String>
                        <x:String>60 FPS</x:String>
                    </RadioButtons>
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="Animation speed" />
                            <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" Opacity="0.7" />
                        </Grid>
                        <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="3" StepFrequency="0.05" ValueChanged="OnChanged" IsThumbToolTipEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Pause automatically" Style="{StaticResource DcSectionTitle}" />
            <Border Style="{StaticResource DcCard}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="PauseFullscreen" Header="When a fullscreen app, game or full-screen window covers the desktop" Toggled="OnChanged" />
                    <ToggleSwitch x:Name="PauseMaximized" Header="When a maximized window covers the wallpaper" Toggled="OnChanged" />
                    <ToggleSwitch x:Name="PauseBattery" Header="When running on battery" Toggled="OnChanged" />
                    <ToggleSwitch x:Name="BatterySaver" Header="Battery saver: limit to 15 FPS on battery" Toggled="OnChanged" />
                    <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Rendering also stops while the screen is locked or the display is off, and resumes automatically when you return to the desktop." />
                </StackPanel>
            </Border>
            <InfoBar x:Name="Info" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
