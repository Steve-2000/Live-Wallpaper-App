<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DreamCanvas.App.ViewModels"
    xmlns:controls="using:DreamCanvas.App.Controls">

    <Page.Resources>
        <DataTemplate x:Key="SmallCard" x:DataType="vm:PresetCard">
            <Grid Width="200" Height="140" CornerRadius="8" Background="{x:Bind Backdrop}"
                  AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                <Border Grid.Row="1" Background="#E6121420" Padding="10,6">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="28,20,28,28">
        <StackPanel Spacing="8" MaxWidth="1200">
            <TextBlock Text="Welcome to DreamCanvas" Style="{StaticResource DcPageTitle}" />
            <TextBlock Text="Original, procedurally generated live wallpapers that run behind your desktop icons." Opacity="0.7" />

            <!-- Hero: live preview of what's on the desktop (or a featured wallpaper) -->
            <Grid Margin="0,12,0,0" CornerRadius="12" Height="300" BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1">
                <controls:WallpaperPreview x:Name="HeroPreview" />
                <Border VerticalAlignment="Bottom" Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#CC000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="HeroCaption" Opacity="0.8" FontSize="12" />
                            <TextBlock x:Name="HeroTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button x:Name="HeroCustomize" Content="Customize" Click="OnHeroCustomize" />
                            <Button x:Name="HeroApply" Style="{StaticResource AccentButtonStyle}" Content="Set as wallpaper" Click="OnHeroApply" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <InfoBar x:Name="HomeInfo" IsClosable="True" />

            <!-- Engine status -->
            <Border Style="{StaticResource DcCard}" Margin="0,8,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" Text="Checking wallpaper engine..." />
                        <TextBlock x:Name="StatusDetail" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseButton" Content="Pause" Click="OnPauseResume" Visibility="Collapsed" />
                        <Button Content="Desktop settings" Click="OnOpenDesktop" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="RecentHeader" Text="Recently applied" Style="{StaticResource DcSectionTitle}" />
            <GridView x:Name="RecentList" ItemTemplate="{StaticResource SmallCard}" IsItemClickEnabled="True" ItemClick="OnCardClick" SelectionMode="None" />

            <TextBlock Text="Recommended" Style="{StaticResource DcSectionTitle}" />
            <GridView x:Name="RecommendedList" ItemTemplate="{StaticResource SmallCard}" IsItemClickEnabled="True" ItemClick="OnCardClick" SelectionMode="None" />

            <TextBlock Text="Categories" Style="{StaticResource DcSectionTitle}" />
            <ItemsRepeater x:Name="CategoryList">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="160" MinItemHeight="56" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnCategoryClick" Tag="{x:Bind}">
                            <TextBlock Text="{x:Bind}" FontWeight="SemiBold" />
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
