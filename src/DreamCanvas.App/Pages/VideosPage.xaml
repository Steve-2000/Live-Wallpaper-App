<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.VideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamCanvas.App.Pages">

    <Grid Padding="28,20,28,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Video Wallpapers" Style="{StaticResource DcPageTitle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Real camera footage as your desktop: your own video files, or free nature videos from Pexels and Pixabay, which allow free use. Videos pause like every other wallpaper when you play games or open full-screen apps." />
        </StackPanel>

        <Pivot x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <!-- ============================================================ My videos -->
            <PivotItem Header="My videos">
                <Grid RowSpacing="10" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ImportButton" Style="{StaticResource AccentButtonStyle}" Click="OnImport" AutomationProperties.Name="Import a video file">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock Text="Import video file…" /></StackPanel>
                        </Button>
                        <Button Click="OnGoFind" AutomationProperties.Name="Find free videos">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="14" /><TextBlock Text="Find free videos" /></StackPanel>
                        </Button>
                        <ComboBox x:Name="FitBox" Header="On screen" MinWidth="190" SelectedIndex="0" VerticalAlignment="Bottom" Margin="12,-22,0,0">
                            <ComboBoxItem Content="Fill the screen (crop edges)" Tag="cover" />
                            <ComboBoxItem Content="Show the whole video" Tag="contain" />
                        </ComboBox>
                        <ProgressRing x:Name="ImportProgress" IsActive="False" Width="22" Height="22" />
                    </StackPanel>

                    <GridView x:Name="Library" Grid.Row="1" SelectionMode="None" Padding="0,4,0,24">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:VideoCard">
                                <Grid Width="270" CornerRadius="8" Background="{StaticResource DcPanelBackground}" BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1"
                                      AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="152" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Background="#0B0C12">
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                        <FontIcon Glyph="&#xE714;" FontSize="34" Opacity="0.35" Visibility="{x:Bind NoThumbnailVisibility}" />
                                        <Border Background="#99000000" CornerRadius="4" Padding="6,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind Details}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Padding="12,10" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CreditLine}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Set as wallpaper" Tag="{x:Bind Id}" Click="OnApply" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Tag="{x:Bind Id}" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Open source page" Tag="{x:Bind Id}" Click="OnOpenSource" IsEnabled="{x:Bind HasSourcePage}" />
                                                        <MenuFlyoutItem Text="Licence" Tag="{x:Bind Id}" Click="OnOpenLicense" IsEnabled="{x:Bind HasLicensePage}" />
                                                        <MenuFlyoutItem Text="Rename" Tag="{x:Bind Id}" Click="OnRename" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete" Tag="{x:Bind Id}" Click="OnDelete" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="460">
                        <FontIcon Glyph="&#xE714;" FontSize="40" Opacity="0.5" />
                        <TextBlock Text="No videos yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"
                                   Text="Import an MP4 or WebM video from your PC, or find free nature videos (forests, oceans, rain, snow, waterfalls...) on Pexels and Pixabay." />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <!-- ============================================================ Find -->
            <PivotItem Header="Find free videos">
                <Grid RowSpacing="10" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="SourceBox" MinWidth="130" SelectionChanged="OnSourceChanged" AutomationProperties.Name="Video site">
                            <ComboBoxItem Content="Pexels" Tag="pexels" />
                            <ComboBoxItem Content="Pixabay" Tag="pixabay" />
                        </ComboBox>
                        <TextBox x:Name="QueryBox" Width="320" PlaceholderText="Search: forest, ocean waves, rain, snow…" KeyDown="OnQueryKeyDown" AutomationProperties.Name="Search videos" />
                        <Button x:Name="SearchButton" Content="Search" Click="OnSearch" Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing x:Name="SearchProgress" IsActive="False" Width="22" Height="22" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                    <ItemsControl x:Name="Topics">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}" Tag="{x:Bind}" Click="OnTopic" Padding="10,3" CornerRadius="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <!-- Shown until the chosen site has an API key. -->
                    <Border x:Name="KeyPanel" Grid.Row="2" Visibility="Collapsed" CornerRadius="8" Padding="16,12" Background="{StaticResource DcPanelBackground}"
                            BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="KeyTitle" FontWeight="SemiBold" Text="Pexels needs a free API key" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.8" x:Name="KeySteps" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton x:Name="KeyLink" Content="Get a free key" Click="OnGetKey" />
                                <PasswordBox x:Name="KeyBox" Width="340" PlaceholderText="Paste your API key here" AutomationProperties.Name="API key" />
                                <Button Content="Save key" Click="OnSaveKey" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <GridView x:Name="Results" Grid.Row="3" SelectionMode="None" Padding="0,4,0,8">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ResultCard">
                                <Grid Width="270" CornerRadius="8" Background="{StaticResource DcPanelBackground}" BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1"
                                      AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="152" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Background="#0B0C12">
                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                        <Border Background="#99000000" CornerRadius="4" Padding="6,2" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind Details}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Padding="12,10" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind CreditLine}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind CanDownloadVisibility, Mode=OneWay}">
                                                <Button Content="Download" Click="OnDownload" Tag="{x:Bind}" />
                                                <HyperlinkButton Content="View" Click="OnViewResult" Tag="{x:Bind}" />
                                            </StackPanel>
                                            <StackPanel Spacing="4" Visibility="{x:Bind DownloadingVisibility, Mode=OneWay}">
                                                <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" />
                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind DoneVisibility, Mode=OneWay}">
                                                <Button Content="Set as wallpaper" Click="OnApplyResult" Tag="{x:Bind}" Style="{StaticResource AccentButtonStyle}" />
                                                <TextBlock Text="In your videos" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock x:Name="ResultsHint" Grid.Row="3" Opacity="0.6" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="Pick a topic above or search for anything you like." />

                    <Grid Grid.Row="4" Padding="0,4,0,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="ProvidedBy" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Text="Videos provided by Pexels." />
                            <HyperlinkButton x:Name="LicenseLink" Content="Licence" FontSize="12" Click="OnSourceLicense" />
                        </StackPanel>
                        <Button x:Name="MoreButton" Grid.Column="1" Content="Load more" Click="OnLoadMore" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>

        <InfoBar x:Name="Info" Grid.Row="1" IsClosable="True" VerticalAlignment="Bottom" Margin="0,0,0,16" />
    </Grid>
</Page>
