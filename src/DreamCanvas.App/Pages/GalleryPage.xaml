<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DreamCanvas.App.ViewModels"
    xmlns:controls="using:DreamCanvas.App.Controls">

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Browse -->
        <Grid Padding="28,20,20,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Wallpaper Gallery" Style="{StaticResource DcPageTitle}" />
                <TextBlock x:Name="CountText" Opacity="0.7" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search wallpapers, tags, categories" QueryIcon="Find"
                                TextChanged="OnFilterChanged" />
                <ComboBox x:Name="CategoryBox" Grid.Column="1" MinWidth="140" SelectionChanged="OnFilterChanged" />
                <ComboBox x:Name="SortBox" Grid.Column="2" MinWidth="130" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                    <x:String>Name</x:String>
                    <x:String>Category</x:String>
                    <x:String>Recently applied</x:String>
                </ComboBox>
                <ToggleButton x:Name="FavoritesToggle" Grid.Column="3" Click="OnFilterChanged" ToolTipService.ToolTip="Show favourites only"
                              AutomationProperties.Name="Favourites only">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE735;" FontSize="14" />
                        <TextBlock Text="Favourites" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <GridView x:Name="Cards" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnCardSelected"
                      Padding="0,4,0,24" IsItemClickEnabled="False">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetCard">
                        <Grid Width="236" Height="176" CornerRadius="8" Background="{x:Bind Backdrop}"
                              AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                            <Border Grid.Row="1" Background="#E6121420" Padding="10,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Opacity="0.65" FontSize="12">
                                            <Run Text="{x:Bind Category}" /><Run Text=" · " /><Run Text="{x:Bind RendererLabel}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14" HorizontalAlignment="Right"
                                              VerticalAlignment="Top" Foreground="#FFD54F" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="No wallpapers match your filters." HorizontalAlignment="Center" />
                <HyperlinkButton Content="Clear filters" HorizontalAlignment="Center" Click="OnClearFilters" />
            </StackPanel>
        </Grid>

        <!-- Details -->
        <Border Grid.Column="1" Background="{StaticResource DcPanelBackground}" BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="DetailScroll" Padding="20,20,20,24" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Border CornerRadius="8" Height="200" BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1">
                        <controls:WallpaperPreview x:Name="Preview" />
                    </Border>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailMeta" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="FavoriteButton" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnToggleFavorite"
                                ToolTipService.ToolTip="Favourite" AutomationProperties.Name="Toggle favourite">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="16" Foreground="#FFD54F" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Opacity="0.85" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="MonitorBox" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Which monitor to apply to" />
                        <Button x:Name="ApplyButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnApply"
                                AutomationProperties.Name="Set as wallpaper">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                <TextBlock Text="Set as wallpaper" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <InfoBar x:Name="ApplyInfo" IsClosable="True" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRandomize" ToolTipService.ToolTip="Randomise every setting" AutomationProperties.Name="Randomize">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Randomize" /></StackPanel>
                        </Button>
                        <Button Click="OnRegenerate" ToolTipService.ToolTip="Keep settings, generate a new procedural layout" AutomationProperties.Name="Regenerate">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Regenerate" /></StackPanel>
                        </Button>
                        <Button Click="OnReset" ToolTipService.ToolTip="Restore the original settings" AutomationProperties.Name="Reset">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE777;" FontSize="14" /><TextBlock Text="Reset" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Customize" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="Changes preview live and are saved automatically for this wallpaper." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <controls:ParamEditor x:Name="Editor" />

                    <TextBlock x:Name="DetailLicense" Opacity="0.5" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="SelectHint" Grid.Column="1" Text="Select a wallpaper to preview and customize it."
                   Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24" />
    </Grid>
</Page>
