<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource DcWindowBackground}">
        <WebView2 x:Name="Web" DefaultBackgroundColor="#0E0F16" />
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="520">
            <TextBlock Text="The editor could not be opened" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.8" />
        </StackPanel>
    </Grid>
</Page>
