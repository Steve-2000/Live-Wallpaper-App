<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamCanvas.App.Pages.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamCanvas.App.Pages">

    <Grid Padding="28,20,28,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="My Projects" Style="{StaticResource DcPageTitle}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="Wallpapers you build in the editor from independently editable objects. Changes save automatically." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <DropDownButton Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="New from template">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New from template" /></StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="TemplateMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Click="OnNewBlank" AutomationProperties.Name="New blank scene">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A5;" FontSize="14" /><TextBlock Text="New blank scene" /></StackPanel>
            </Button>
        </StackPanel>

        <GridView x:Name="Cards" Grid.Row="2" SelectionMode="None" Padding="0,4,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:ProjectCard">
                    <Grid Width="260" CornerRadius="8" Background="{StaticResource DcPanelBackground}" BorderBrush="{StaticResource DcCardBorder}" BorderThickness="1"
                          AutomationProperties.Name="{x:Bind Name}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="146" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Background="#0B0C12">
                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                            <TextBlock Text="Open it in the editor to create a preview" Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Visibility="{x:Bind NoThumbnailVisibility}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Padding="12,10" Spacing="8">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Updated}" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Edit" Tag="{x:Bind Id}" Click="OnEdit" />
                                <Button Content="Set as wallpaper" Tag="{x:Bind Id}" Click="OnApply" />
                                <Button Tag="{x:Bind Id}" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Duplicate" Tag="{x:Bind Id}" Click="OnDuplicate" />
                                            <MenuFlyoutItem Text="Rename" Tag="{x:Bind Id}" Click="OnRename" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete" Tag="{x:Bind Id}" Click="OnDelete" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
            <TextBlock Text="No projects yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"
                       Text="Start from a template (Night Forest, Desk Widgets with clocks, calendar and system monitor, or Word Clock), or from a blank canvas." />
        </StackPanel>

        <InfoBar x:Name="Info" Grid.Row="2" IsClosable="True" VerticalAlignment="Bottom" Margin="0,0,0,16" />
    </Grid>
</Page>
