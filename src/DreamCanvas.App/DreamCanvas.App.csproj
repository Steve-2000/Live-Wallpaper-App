<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DreamCanvas.App</RootNamespace>
    <AssemblyName>DreamCanvas</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: shipped by our own installer, no MSIX / Visual Studio tooling required. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Required for `dotnet publish` to include the app's resources.pri and compiled XAML (.xbf)
         even though the app isn't packaged; without it the published app fails to load any page. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\dreamcanvas.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Only the Windows App SDK components DreamCanvas uses. The all-in-one Microsoft.WindowsAppSDK
         package also ships AI/ML/Search/Widgets (onnxruntime, DirectML...), about 40 MB never loaded. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DreamCanvas.Core\DreamCanvas.Core.csproj" />
    <ProjectReference Include="..\DreamCanvas.Native\DreamCanvas.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\dreamcanvas.ico" Link="Assets\dreamcanvas.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
