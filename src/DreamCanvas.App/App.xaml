<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DreamCanvas.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="DcAccentColor">#7B61FF</Color>
            <SolidColorBrush x:Key="DcAccentBrush" Color="{StaticResource DcAccentColor}" />
            <SolidColorBrush x:Key="DcWindowBackground" Color="#0E0F16" />
            <SolidColorBrush x:Key="DcPanelBackground" Color="#161824" />
            <SolidColorBrush x:Key="DcCardBorder" Color="#262A3A" />

            <Style x:Key="DcPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="DcSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>
            <Style x:Key="DcCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DcPanelBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource DcCardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
