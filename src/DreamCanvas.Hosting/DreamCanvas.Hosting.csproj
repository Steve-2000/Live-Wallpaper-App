<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DreamCanvas.Hosting</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The WebView2 package always references its (unused here) WPF assembly, which trips a WindowsBase version notice. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DreamCanvas.Core\DreamCanvas.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
