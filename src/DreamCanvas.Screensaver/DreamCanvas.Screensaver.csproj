<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DreamCanvas.Screensaver</RootNamespace>
    <AssemblyName>DreamCanvas.Screensaver</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\dreamcanvas.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <Product>DreamCanvas</Product>
    <AssemblyTitle>DreamCanvas</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DreamCanvas.Core\DreamCanvas.Core.csproj" />
    <ProjectReference Include="..\DreamCanvas.Native\DreamCanvas.Native.csproj" />
    <ProjectReference Include="..\DreamCanvas.Hosting\DreamCanvas.Hosting.csproj" />
  </ItemGroup>

  <!-- Windows launches screensavers as *.scr: ship a .scr copy of the apphost next to the .exe. -->
  <Target Name="CopyScr" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).exe" DestinationFiles="$(OutDir)DreamCanvas.scr" SkipUnchangedFiles="true" />
    <Copy Condition="'$(PublishDir)' != '' And Exists('$(PublishDir)$(AssemblyName).exe')"
          SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)DreamCanvas.scr" SkipUnchangedFiles="true" />
  </Target>
</Project>
