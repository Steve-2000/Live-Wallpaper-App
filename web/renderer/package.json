{
  "name": "@dreamcanvas/renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DreamCanvas wallpaper runtime: hosts procedural presets inside WebView2.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/emit-manifests.mjs && node scripts/thumbnails.mjs",
    "build:fast": "tsc --noEmit && vite build && node scripts/emit-manifests.mjs",
    "thumbnails": "node scripts/thumbnails.mjs",
    "test": "vitest run",
    "e2e": "node scripts/editor-e2e.mjs",
    "smoke": "node scripts/preset-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
