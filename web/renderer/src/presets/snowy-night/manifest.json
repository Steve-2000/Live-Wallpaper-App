{
  "id": "snowy-night",
  "name": "Snowy Night",
  "description": "Snow drifts down in layers over moonlit hills and pine woods. Wind and the amount of snow are adjustable.",
  "category": "Weather",
  "tags": ["snow", "winter", "night", "moon", "forest", "calm", "shader"],
  "renderer": "webgl",
  "accent": ["#0b1530", "#dfe9ff"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "skyTop", "label": "Upper sky", "type": "color", "default": "#0b1530" },
    { "key": "skyBottom", "label": "Lower sky", "type": "color", "default": "#2c4a78" },
    { "key": "snowColor", "label": "Snow colour", "type": "color", "default": "#e6efff" },
    { "key": "amount", "label": "Snowfall", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.6 },
    { "key": "flakeSize", "label": "Flake size", "type": "range", "min": 0.5, "max": 2, "step": 0.05, "default": 1 },
    { "key": "wind", "label": "Wind", "type": "range", "min": -1, "max": 1, "step": 0.05, "default": 0.2 },
    { "key": "moon", "label": "Moon", "type": "bool", "default": true },
    { "key": "flow", "label": "Speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.7 }
  ]
}
