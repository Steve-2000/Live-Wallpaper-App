    { "key": "drift", "label": "Drift speed", "type": "range", "min": 0.1, "max": 3, "step": 0.05, "default": 1 },
    { "key": "skyTop", "label": "Sky (top)", "type": "color", "default": "#050b1c" },
    { "key": "skyBottom", "label": "Sky (horizon)", "type": "color", "default": "#14323a" },
    { "key": "treeDensity", "label": "Forest density", "type": "range", "min": 0.3, "max": 1.6, "step": 0.05, "default": 1 },
