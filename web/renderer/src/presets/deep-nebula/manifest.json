{
  "id": "deep-nebula",
  "name": "Deep Nebula",
  "description": "Billowing clouds of interstellar gas glow in two colours behind a field of twinkling stars, slowly drifting.",
  "category": "Space",
  "tags": ["space", "nebula", "stars", "colourful", "calm", "shader"],
  "renderer": "webgl",
  "accent": ["#0a0018", "#ff4fa3"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "colorA", "label": "Gas colour 1", "type": "color", "default": "#ff4fa3" },
    { "key": "colorB", "label": "Gas colour 2", "type": "color", "default": "#3a7bff" },
    { "key": "space", "label": "Space colour", "type": "color", "default": "#0a0018" },
    { "key": "density", "label": "Gas density", "type": "range", "min": 0.2, "max": 1.5, "step": 0.05, "default": 1 },
    { "key": "detail", "label": "Swirl", "type": "range", "min": 0.5, "max": 4, "step": 0.1, "default": 2.5 },
    { "key": "stars", "label": "Stars", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.7 },
    { "key": "flow", "label": "Drift speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 0.5 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.6 }
  ]
}
