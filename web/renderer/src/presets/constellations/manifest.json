{
  "id": "constellations",
  "name": "Constellation Network",
  "description": "Points of light drift slowly and link up with fine lines whenever they pass close to each other.",
  "category": "Minimal",
  "tags": ["minimal", "network", "lines", "particles", "calm", "dark"],
  "renderer": "canvas2d",
  "accent": ["#070b18", "#7fd8ff"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "backgroundTop", "label": "Background (top)", "type": "color", "default": "#070b18" },
    { "key": "backgroundBottom", "label": "Background (bottom)", "type": "color", "default": "#13203d" },
    { "key": "pointColor", "label": "Point colour", "type": "color", "default": "#bfe9ff" },
    { "key": "lineColor", "label": "Line colour", "type": "color", "default": "#7fd8ff" },
    { "key": "count", "label": "Points", "type": "range", "min": 20, "max": 260, "step": 5, "default": 110 },
    { "key": "linkDistance", "label": "Link distance", "type": "range", "min": 40, "max": 260, "step": 5, "default": 150 },
    { "key": "speed", "label": "Drift speed", "type": "range", "min": 0, "max": 3, "step": 0.05, "default": 1 },
    { "key": "glow", "label": "Glow", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.6 }
  ]
}
