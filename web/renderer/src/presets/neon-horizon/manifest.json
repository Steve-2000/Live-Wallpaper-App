{
  "id": "neon-horizon",
  "name": "Neon Horizon",
  "description": "A retro-futuristic drive: a glowing grid rushes towards you under a striped sunset sun and neon-edged mountains.",
  "category": "Neon",
  "tags": ["neon", "retro", "synth", "grid", "sunset", "80s", "shader"],
  "renderer": "webgl",
  "accent": ["#12002a", "#ff2e88"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "skyTop", "label": "Upper sky", "type": "color", "default": "#12002a" },
    { "key": "skyGlow", "label": "Horizon glow", "type": "color", "default": "#ff2e88" },
    { "key": "grid", "label": "Grid colour", "type": "color", "default": "#00e5ff" },
    { "key": "sunTop", "label": "Sun (top)", "type": "color", "default": "#ffe066" },
    { "key": "sunBottom", "label": "Sun (bottom)", "type": "color", "default": "#ff3d81" },
    { "key": "mountains", "label": "Mountains", "type": "bool", "default": true },
    { "key": "stars", "label": "Stars", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.5 },
    { "key": "flow", "label": "Drive speed", "type": "range", "min": 0, "max": 3, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.7 }
  ]
}
