{
  "id": "city-lights",
  "name": "City Lights",
  "description": "A night skyline in three layers: windows switch on and off, aircraft lights blink on the towers and traffic streams below.",
  "category": "City",
  "tags": ["city", "night", "skyline", "urban", "lights", "shader"],
  "renderer": "webgl",
  "accent": ["#0a0f2c", "#ffcf6e"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "skyTop", "label": "Upper sky", "type": "color", "default": "#0a0f2c" },
    { "key": "skyBottom", "label": "City glow", "type": "color", "default": "#4a2f6a" },
    { "key": "building", "label": "Buildings", "type": "color", "default": "#0d0f1a" },
    { "key": "window", "label": "Window light", "type": "color", "default": "#ffcf6e" },
    { "key": "lights", "label": "Lit windows", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.45 },
    { "key": "traffic", "label": "Traffic", "type": "bool", "default": true },
    { "key": "stars", "label": "Stars", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.4 },
    { "key": "flow", "label": "Speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.8 }
  ]
}
