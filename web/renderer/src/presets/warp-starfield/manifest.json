{
  "id": "warp-starfield",
  "name": "Warp Starfield",
  "description": "Fly through deep space: stars stream past from the centre, stretching into light trails at speed.",
  "category": "Space",
  "tags": ["space", "stars", "flight", "speed", "dark", "shader"],
  "renderer": "webgl",
  "accent": ["#02030a", "#cfe3ff"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "background", "label": "Space colour", "type": "color", "default": "#02030a" },
    { "key": "starColor", "label": "Star colour", "type": "color", "default": "#cfe3ff" },
    { "key": "nebula", "label": "Nebula tint", "type": "color", "default": "#5a3cff" },
    { "key": "density", "label": "Star density", "type": "range", "min": 0.1, "max": 1, "step": 0.05, "default": 0.55 },
    { "key": "streaks", "label": "Light trails", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.5 },
    { "key": "nebulaAmount", "label": "Nebula", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.35 },
    { "key": "flow", "label": "Speed", "type": "range", "min": 0, "max": 3, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.75 }
  ]
}
