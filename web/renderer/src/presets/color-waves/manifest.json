{
  "id": "color-waves",
  "name": "Flowing Color Waves",
  "description": "Layered, slowly flowing ribbons of colour with soft light bands - a calm abstract backdrop.",
  "category": "Abstract",
  "tags": ["abstract", "gradient", "minimal", "shader"],
  "renderer": "webgl",
  "accent": ["#1b0b3a", "#ff6fa8"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "colorA", "label": "Colour 1", "type": "color", "default": "#1b0b3a" },
    { "key": "colorB", "label": "Colour 2", "type": "color", "default": "#ff6fa8" },
    { "key": "colorC", "label": "Colour 3", "type": "color", "default": "#4cc9f0" },
    { "key": "waves", "label": "Wave layers", "type": "range", "min": 2, "max": 9, "step": 1, "default": 5 },
    { "key": "amplitude", "label": "Wave height", "type": "range", "min": 0.02, "max": 0.3, "step": 0.01, "default": 0.12 },
    { "key": "flow", "label": "Flow speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 0.5 },
    { "key": "glow", "label": "Glow", "type": "range", "min": 0, "max": 1.5, "step": 0.05, "default": 0.6 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.6 }
  ]
}
