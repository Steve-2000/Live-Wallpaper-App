{
  "id": "desert-dunes",
  "name": "Desert Dunes",
  "description": "Layered sand dunes under a hazy sky, with sharp sunlit crests, soft shadows and sand drifting off the ridges.",
  "category": "Nature",
  "tags": ["nature", "desert", "sand", "warm", "landscape", "minimal", "shader"],
  "renderer": "webgl",
  "accent": ["#f2c27b", "#7ec8ff"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "sky", "label": "Sky colour", "type": "color", "default": "#6fb6ec" },
    { "key": "haze", "label": "Horizon haze", "type": "color", "default": "#ffd9a8" },
    { "key": "sandLight", "label": "Sunlit sand", "type": "color", "default": "#f2c27b" },
    { "key": "sandShade", "label": "Shaded sand", "type": "color", "default": "#a8643f" },
    { "key": "sun", "label": "Sun colour", "type": "color", "default": "#fff1c9" },
    { "key": "sunHeight", "label": "Sun height", "type": "range", "min": 0.1, "max": 0.9, "step": 0.01, "default": 0.6 },
    { "key": "drift", "label": "Blowing sand", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.5 },
    { "key": "flow", "label": "Wind speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 0.6 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.7 }
  ]
}
