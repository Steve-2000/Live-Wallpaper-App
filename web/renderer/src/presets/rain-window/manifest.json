{
  "id": "rain-window",
  "name": "Rainy Window",
  "description": "Raindrops bead and run down a window pane, bending the soft, out-of-focus city lights behind the glass.",
  "category": "Weather",
  "tags": ["rain", "weather", "city", "bokeh", "cozy", "night", "shader"],
  "renderer": "webgl",
  "accent": ["#14202e", "#ffb86b"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "tint", "label": "Night colour", "type": "color", "default": "#14202e" },
    { "key": "lightA", "label": "Warm lights", "type": "color", "default": "#ffb86b" },
    { "key": "lightB", "label": "Cool lights", "type": "color", "default": "#6bc6ff" },
    { "key": "rain", "label": "Rain amount", "type": "range", "min": 0.05, "max": 1, "step": 0.05, "default": 0.7 },
    { "key": "dropSize", "label": "Drop size", "type": "range", "min": 0.5, "max": 2, "step": 0.05, "default": 1 },
    { "key": "lights", "label": "City lights", "type": "range", "min": 0, "max": 1.5, "step": 0.05, "default": 1 },
    { "key": "flow", "label": "Speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.7 }
  ]
}
