{
  "id": "liquid-marble",
  "name": "Liquid Marble",
  "description": "Slowly swirling marbled colour with fine metallic veins, like ink folding through liquid stone.",
  "category": "Abstract",
  "tags": ["abstract", "marble", "fluid", "elegant", "gold", "shader"],
  "renderer": "webgl",
  "accent": ["#0e1a40", "#e0c3fc"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "colorA", "label": "Deep colour", "type": "color", "default": "#0e1a40" },
    { "key": "colorB", "label": "Light colour", "type": "color", "default": "#e0c3fc" },
    { "key": "vein", "label": "Vein colour", "type": "color", "default": "#ffd166" },
    { "key": "scale", "label": "Pattern size", "type": "range", "min": 0.4, "max": 3, "step": 0.05, "default": 1.2 },
    { "key": "swirl", "label": "Swirl", "type": "range", "min": 0, "max": 3, "step": 0.05, "default": 1.6 },
    { "key": "veins", "label": "Veins", "type": "range", "min": 0, "max": 1.5, "step": 0.05, "default": 0.8 },
    { "key": "flow", "label": "Speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 0.5 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.6 }
  ]
}
