{
  "id": "thunderstorm",
  "name": "Thunderstorm",
  "description": "Heavy clouds churn overhead, rain sweeps across the scene and lightning forks down now and then, lighting up the sky.",
  "category": "Weather",
  "tags": ["weather", "storm", "lightning", "rain", "dark", "dramatic", "shader"],
  "renderer": "webgl",
  "accent": ["#1c2230", "#c9d6ff"],
  "author": "DreamCanvas",
  "license": "MIT - original procedural artwork",
  "params": [
    { "key": "cloud", "label": "Cloud colour", "type": "color", "default": "#1c2230" },
    { "key": "light", "label": "Lightning colour", "type": "color", "default": "#c9d6ff" },
    { "key": "ground", "label": "Land colour", "type": "color", "default": "#07090d" },
    { "key": "rain", "label": "Rain", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.7 },
    { "key": "lightning", "label": "Lightning", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 0.45 },
    { "key": "wind", "label": "Wind", "type": "range", "min": -1, "max": 1, "step": 0.05, "default": 0.25 },
    { "key": "flow", "label": "Speed", "type": "range", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "key": "quality", "label": "Render quality", "type": "range", "min": 0.35, "max": 1, "step": 0.05, "default": 0.6 }
  ]
}
